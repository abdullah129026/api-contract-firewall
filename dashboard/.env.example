# Supabase project (project settings -> API).
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key>

# Shared bearer secret between the proxy worker and /api/ingest. The deployer
# generates it once (openssl rand -base64 32) and sets the same value as the
# worker's INGEST_SECRET secret. The dashboard rejects ingest calls without it.
INGEST_SECRET=<paste the shared secret here>

# Deployed proxy worker URL. Shown on the setup screen (copyable curl
# commands) and used by the test-request button. Either var works.
NEXT_PUBLIC_PROXY_URL=https://<worker>.<subdomain>.workers.dev
PROXY_URL=https://<worker>.<subdomain>.workers.dev
