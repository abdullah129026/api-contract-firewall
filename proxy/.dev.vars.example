# Copy to .dev.vars (gitignored) for `npx wrangler dev`. The four real secrets
# are set on the deployed worker with `npx wrangler secret put <NAME>`; they
# never go in this file or in wrangler.json.

# Local-dev key registry only. Deploy uses the Supabase api_keys table.
SERVICES_JSON={"<api-key>":{"origin":"http://localhost:3001","name":"demo"}}

# Where the worker POSTs masked samples (your dashboard URL + /api/ingest).
INGEST_URL=http://localhost:3000/api/ingest

# Long random string, shared with the dashboard's INGEST_SECRET. Generated by
# the deployer at deploy time; never created or stored by anyone else.
INGEST_SECRET=<paste the shared secret here>

# Supabase project. Needed in dev only if you want key lookup through the DB.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
